{
    "name": "tihloh/prefab-messaging",
    "description": "Standalone, framework-independent application messaging with direct mail, notifications and pluggable delivery channels for Prefab PHP.",
    "keywords": ["php", "messaging", "email", "notifications", "smtp", "prefab", "modular", "framework-independent"],
    "homepage": "https://github.com/tihloh/prefab-php",
    "type": "library",
    "license": "MIT",
    "authors": [{"name": "Christian Bustamante"}],
    "support": {
        "issues": "https://github.com/tihloh/prefab-php/issues",
        "source": "https://github.com/tihloh/prefab-php"
    },
    "require": {"php": ">=8.1"},
    "suggest": {
        "tihloh/prefab-users": "Optional recipient/user resolution.",
        "tihloh/prefab-files": "Optional attachment/file integration.",
        "tihloh/prefab-logs": "Optional delivery activity logging."
    },
    "autoload": {"psr-4": {"Tihloh\\Prefab\\Messaging\\": "src/"}}
}
