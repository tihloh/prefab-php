  "type": "library",
  "license": "MIT",
  "authors": [
    {"name": "Christian Bustamante"}
  ],
  "support": {
    "issues": "https://github.com/tihloh/prefab-php/issues",
    "source": "https://github.com/tihloh/prefab-php"
  },
  "require": {
    "php": ">=8.1",
    "tihloh/prefab-core": "^0.4 || ^0.5"
  },
  "autoload": {
    "psr-4": {
      "Tihloh\\Prefab\\Background\\": "src/"
    }
  },
  "bin": [
