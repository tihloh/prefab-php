{
  "name": "tihloh/prefab-auth-server",
  "description": "Framework-independent OAuth 2.0 and OpenID Connect provider support for Prefab PHP.",
  "keywords": ["php", "oauth2", "openid-connect", "oidc", "sso", "prefab", "framework-independent"],
  "homepage": "https://github.com/tihloh/prefab-php",
  "type": "library",
  "license": "MIT",
  "authors": [{"name": "Christian Bustamante"}],
  "support": {
    "issues": "https://github.com/tihloh/prefab-php/issues",
    "source": "https://github.com/tihloh/prefab-php"
  },
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-openssl": "*",
    "tihloh/prefab-core": "^0.4 || ^0.5",
    "tihloh/prefab-auth": "^0.4 || ^0.5",
    "league/oauth2-server": "^9.3",
    "lcobucci/jwt": "^5.0",
    "psr/http-message": "^2.0"
  },
  "suggest": {
    "ext-pdo": "Required for the built-in PDO repositories and schema installer.",
    "nyholm/psr7": "Convenient PSR-7 implementation for standalone applications."
  },
  "autoload": {
    "psr-4": {
      "Tihloh\\Prefab\\AuthServer\\": "src/"
    }
  },
  "require-dev": {
    "nyholm/psr7": "^1.8"
  }
}
