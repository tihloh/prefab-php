{
    "name": "tihloh/prefab-routes",
    "description": "Lightweight, framework-independent routing for Prefab PHP that scales from small sites to modular applications.",
    "keywords": ["php", "router", "routing", "routes", "middleware", "prefab", "modular", "framework-independent"],
    "homepage": "https://github.com/tihloh/prefab-php",
    "type": "library",
    "license": "MIT",
    "authors": [{"name": "Christian Bustamante"}],
    "support": {"issues": "https://github.com/tihloh/prefab-php/issues", "source": "https://github.com/tihloh/prefab-php"},
    "require": {"php": ">=8.1"},
    "suggest": {
        "tihloh/prefab-auth": "Optional authentication integration.",
        "tihloh/prefab-permissions": "Optional route permission integration.",
        "tihloh/prefab-logs": "Optional route activity/audit integration."
    },
    "autoload": {
        "psr-4": {"Tihloh\\Prefab\\Routes\\": "src/"},
        "files": ["src/prefab-diagnostics.php", "src/prefab.php"]
    }
}
