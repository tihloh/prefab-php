{
  "name": "tihloh/prefab-core",
  "description": "Shared infrastructure for Prefab PHP modules: runtime, config, database, session, cache, contracts, diagnostics and CLI.",
  "keywords": ["php", "prefab", "core", "runtime", "database", "session", "cache", "cli", "dotenv", "modular", "framework-independent"],
  "homepage": "https://github.com/tihloh/prefab-php",
  "type": "library",
  "license": "MIT",
  "authors": [
    {"name": "Christian Bustamante"}
  ],
  "support": {
    "issues": "https://github.com/tihloh/prefab-php/issues",
    "source": "https://github.com/tihloh/prefab-php"
  },
  "require": {
    "php": ">=8.1"
  },
  "suggest": {
    "ext-pdo": "Required when using Core database infrastructure."
  },
  "autoload": {
    "psr-4": {
      "Tihloh\\Prefab\\Core\\": "src/"
    },
    "files": [
      "src/env.php",
      "src/prefab-debug-ui.php",
      "src/prefab-diagnostics.php",
      "src/prefab.php",
      "src/database.php",
      "src/Console/helpers.php"
    ]
  },
  "bin": [
    "bin/prefab"
  ]
}
