<?php

/*
 | PERMISSIONS + LOGS TEST — PREFAB INITIALIZATION OPTIONS
 |
 | Core always discovers and integrates compatible modules. If Permissions and
 | Logs are available, permission changes can be recorded automatically without
 | manually calling $logs->record(...).
 |
 | Preferred setup:
 |
 |   // $prefab = \Tihloh\Prefab\Core\Prefab::create(['db' => $pdo]);
 |
 | Optional dedicated log connection:
 |
 |   // $prefab = \Tihloh\Prefab\Core\Prefab::create([
 |   //     'connections' => [
 |   //         'default' => $mainPdo,
 |   //         'logs' => $logPdo,
 |   //     ],
 |   // ]);
 |
 | Explicit initialization is only needed when the permission store/definitions
 | or log repository cannot be inferred:
 |
 |   // 'modules' => [
 |   //     'permissions' => $customPermissions,
 |   //     'logs' => $customLogs,
 |   // ]
 |
 | Users/Auth remain automatically discoverable and can provide subject/actor
 | context when present.
 */
