<?php

use Tihloh\Prefab\Core\Prefab;

/*
 * Copy only the initialization your project actually needs.
 * Discovery/integration is ALWAYS automatic.
 *
 * DEFAULT:
 * $prefab = Prefab::create(['db' => $pdo]);
 *
 * NO DATABASE / session-backed example:
 * $prefab = Prefab::create();
 *
 * MULTIPLE DATABASES:
 * $prefab = Prefab::create([
 *     'connections' => ['default' => $mainPdo, 'logs' => $logPdo],
 * ]);
 *
 * CUSTOM MODULE FACTORY — only when Prefab has no automatic/default way to
 * initialize that module:
 * $prefab = Prefab::create([
 *     'db' => $pdo,
 *     'module_options' => [
 *         // 'users' => ['factory' => fn ($prefab, $options) => new MyUserManager(...)],
 *     ],
 * ]);
 *
 * EXPLICIT MODULE INSTANCE — useful when the module has no other initialized
 * module/default resource to derive from, or a custom implementation is needed:
 * $prefab = Prefab::create([
 *     'modules' => [
 *         // 'users' => $users,
 *         // 'auth' => $auth,
 *     ],
 * ]);
 *
 * Explicit initialization never disables discovery. Other available modules
 * continue to be discovered and integrated automatically.
 */
