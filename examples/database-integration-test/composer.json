{
  "name": "tihloh/prefab-database-integration-test",
  "description": "Real SQLite example demonstrating Prefab Core database infrastructure, standalone feature modules, auto-integration, permission inheritance, and a separate logs database.",
  "type": "project",
  "repositories": [
    {"type": "path", "url": "../../packages/core", "options": {"symlink": true}},
    {"type": "path", "url": "../../packages/users", "options": {"symlink": true}},
    {"type": "path", "url": "../../packages/auth", "options": {"symlink": true}},
    {"type": "path", "url": "../../packages/permissions", "options": {"symlink": true}},
    {"type": "path", "url": "../../packages/logs", "options": {"symlink": true}}
  ],
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "tihloh/prefab-core": "@dev",
    "tihloh/prefab-users": "@dev",
    "tihloh/prefab-auth": "@dev",
    "tihloh/prefab-permissions": "@dev",
    "tihloh/prefab-logs": "@dev"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
