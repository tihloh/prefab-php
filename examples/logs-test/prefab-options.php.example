<?php

/*
 | LOGS TEST — PREFAB INITIALIZATION OPTIONS
 |
 | Prefab Core always discovers compatible modules. This test manually creates
 | LogManager only so the Logs module can be tested alone.
 |
 | Normal project setup:
 |
 |   // $prefab = \Tihloh\Prefab\Core\Prefab::create(['db' => $pdo]);
 |
 | Optional dedicated log database:
 |
 |   // $prefab = \Tihloh\Prefab\Core\Prefab::create([
 |   //     'connections' => [
 |   //         'default' => $mainPdo,
 |   //         'logs' => $logPdo,
 |   //     ],
 |   // ]);
 |
 | Explicit Logs initialization is only needed when Prefab cannot infer the log
 | repository/storage implementation:
 |
 |   // $prefab = \Tihloh\Prefab\Core\Prefab::create([
 |   //     'modules' => [
 |   //         'logs' => new \Tihloh\Prefab\Logs\Services\LogManager(
 |   //             new MyLogRepository($logPdo)
 |   //         ),
 |   //     ],
 |   // ]);
 |
 | If Auth/Users/Permissions are also present, their compatible activity is wired
 | to Logs automatically.
 */
