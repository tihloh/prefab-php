<?php

/*
 | AUTH + LOGS TEST — PREFAB INITIALIZATION OPTIONS
 |
 | Core always discovers and integrates compatible modules. If Auth and Logs can
 | be initialized from available defaults/resources, login/logout activity is
 | wired to Logs automatically.
 |
 | Preferred setup:
 |
 |   // $prefab = \Tihloh\Prefab\Core\Prefab::create(['db' => $pdo]);
 |
 | Optional separate log database:
 |
 |   // $prefab = \Tihloh\Prefab\Core\Prefab::create([
 |   //     'connections' => [
 |   //         'default' => $mainPdo,
 |   //         'logs' => $logPdo,
 |   //     ],
 |   // ]);
 |
 | Explicit Auth or Logs initialization is only needed for custom providers,
 | sessions, or log repositories that Prefab cannot infer.
 |
 |   // 'modules' => [
 |   //     'auth' => $customAuth,
 |   //     'logs' => $customLogs,
 |   // ]
 |
 | Discovery of Users/Permissions remains automatic regardless.
 */
