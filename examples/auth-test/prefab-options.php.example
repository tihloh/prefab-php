/*
 | AUTH TEST — PREFAB INITIALIZATION OPTIONS
 |
 | Prefab Core always discovers compatible modules automatically. This test
 | manually creates AuthManager only to isolate password/session authentication.
 |
 | Normal project setup:
 |
 |   // $prefab = \Tihloh\Prefab\Core\Prefab::create(['db' => $pdo]);
 |
 | If Users is already initialized and Prefab can derive an Auth user provider
 | from it, Auth should initialize without another explicit registration.
 |
 | Explicit Auth initialization is needed only for a custom user/session source:
 |
 |   // $prefab = \Tihloh\Prefab\Core\Prefab::create([
 |   //     'module_options' => [
 |   //         'auth' => [
 |   //             'factory' => fn ($prefab, $options) =>
 |   //                 new \Tihloh\Prefab\Auth\Services\AuthManager(
 |   //                     new MyAuthUserProvider(...),
 |   //                     new MySessionStore(...)
 |   //                 ),
 |   //         ],
 |   //     ],
 |   // ]);
 |
 | If Logs is available, login/logout activity is integrated automatically.
 */
