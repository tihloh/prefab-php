<?php

/*
 | USERS TEST — PREFAB INITIALIZATION OPTIONS
 |
 | Prefab Core always discovers available modules automatically.
 | This standalone example directly constructs UserManager only to isolate and
 | demonstrate the Users module without requiring Core.
 |
 | In a normal project with Core, the preferred setup is simply:
 |
 |   // $prefab = \Tihloh\Prefab\Core\Prefab::create(['db' => $pdo]);
 |
 | If Users can be initialized from the project's/default user source, nothing
 | else is required. Other installed Prefab modules are discovered automatically.
 |
 | Explicit Users initialization is only needed when Prefab cannot infer your
 | project's user provider, for example an existing/custom employee table:
 |
 |   // $prefab = \Tihloh\Prefab\Core\Prefab::create([
 |   //     'module_options' => [
 |   //         'users' => [
 |   //             'factory' => fn ($prefab, $options) =>
 |   //                 new \Tihloh\Prefab\Users\Services\UserManager(
 |   //                     new MyProjectUserProvider($pdo)
 |   //                 ),
 |   //         ],
 |   //     ],
 |   // ]);
 |
 | Explicit initialization never disables discovery of Auth, Permissions, Logs,
 | or any other compatible module.
 */
